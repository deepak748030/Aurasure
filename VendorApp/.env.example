# ─────────────────────────────────────────────────────────────────────────────
# Aurasure Vendor App — environment variables
# Copy this file to .env and fill in the values.
# Expo reads EXPO_PUBLIC_* from .env at build time (requires Expo SDK 49+).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Aurasure backend — no trailing slash, no /api/v1.
# Example (local dev):  http://localhost:5000
# Example (Arena):      https://5000-xxxx.e2b.app
# Leave empty to run without a server (some screens will show empty states).
EXPO_PUBLIC_API_URL=http://localhost:5000

# Set to 1 to force the Play in-app update check in a debug build (device must
# have the app installed from the Play Store). Leave unset/0 in production.
EXPO_PUBLIC_IN_APP_UPDATE_DEBUG=0
