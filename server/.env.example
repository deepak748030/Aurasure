# ------------------------------------------------------------------
# Aurasure API server - environment variables
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
# Local (docker compose): mongodb://127.0.0.1:27017/aurasure
MONGODB_URI=mongodb://127.0.0.1:27017/aurasure
MONGODB_OPTIONS_MAX_POOL_SIZE=10
MONGODB_OPTIONS_SERVER_SELECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS - comma separated origins. Use * for any (dev only).
CORS_ORIGIN=*

# Image uploads (multer - stored on this server, no third-party storage)
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=10
# Absolute base URL used inside stored image links. Leave empty in local dev
# (the request host is used); set it in production, e.g. https://api.aurasure.app
PUBLIC_BASE_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
MORGAN_FORMAT=dev
