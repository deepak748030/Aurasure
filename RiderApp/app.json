{
  "expo": {
    "name": "Aurasure Rider",
    "slug": "aurasure-rider",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "aurasurerider",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "entryPoint": "index.js",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#67014B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurasure.rider",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aurasure Rider uses your location while you are online or completing a delivery to show routes and keep operations updated.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aurasure Rider shares your location only during an online shift or active delivery so customers and operations can follow the delivery safely."
      }
    },
    "android": {
      "package": "com.aurasure.rider",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#67014B"
      },
      "navigationBarColor": "#FFFFFF",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": { "tsconfigPaths": true },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#67014B"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aurasure Rider shares your location only while you are online or on an active delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "backgroundColor": "#FFFFFF"
  }
}
