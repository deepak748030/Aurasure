# ── Aurasure Node.js API ────────────────────────────────────────────────────
# Base URL of `server/` (no trailing slash, no /api/v1).
#   • Android emulator  → http://10.0.2.2:5000
#   • Physical device   → http://<your-lan-ip>:5000
#   • Web preview       → http://localhost:5000
# Note: EAS cloud builds do NOT upload this local .env. For cloud `eas build`,
# set the variable in Expo dashboard → Environment variables / secrets instead
# of adding it to `eas.json`.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Currency symbol used by `money()` formatting.
EXPO_PUBLIC_CURRENCY=₹

# Set to 1 to force the Play in-app update check in a debug build (device must
# have the app installed from the Play Store). Leave unset/0 in production.
EXPO_PUBLIC_IN_APP_UPDATE_DEBUG=0
