# ------------------------------------------------------------------
# Aurasure API server - environment variables
# Copy this file to `.env` and adjust the values.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
# Local (docker compose): mongodb://127.0.0.1:27017/aurasure
MONGODB_URI=mongodb://127.0.0.1:27017/aurasure
MONGODB_OPTIONS_MAX_POOL_SIZE=10
MONGODB_OPTIONS_SERVER_SELECTION_TIMEOUT_MS=5000

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS - comma separated origins. Use * for any (dev only).
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Logging
MORGAN_FORMAT=dev
