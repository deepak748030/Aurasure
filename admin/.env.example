# ------------------------------------------------------------------
# Aurasure Admin panel - environment
# Copy this file to `.env.local`
# ------------------------------------------------------------------

# Base URL of the Aurasure Node.js API (server/). No trailing slash and no
# `/api/v1` suffix - the panel adds it. Used server-side by the Next rewrite,
# so the browser only ever calls the same origin.
ADMIN_API_URL=http://127.0.0.1:5000

# Optional label shown in the sidebar footer / settings screen.
NEXT_PUBLIC_ADMIN_ENV=development
