{
  "expo": {
    "name": "Aurasure Vendor",
    "slug": "aurasure-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aurasurevendor",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "entryPoint": "index.js",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurasure.vendor"
    },
    "android": {
      "package": "com.aurasure.vendor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#5B46E5"
      },
      "navigationBarColor": "#F5EAF3"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": { "tsconfigPaths": true },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "backgroundColor": "#F5EAF3"
  }
}
