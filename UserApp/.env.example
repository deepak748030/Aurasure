# ── Aurasure Node.js API ────────────────────────────────────────────────────
# Base URL of `server/` (no trailing slash, no /api/v1).
#   • Android emulator  → http://10.0.2.2:5000
#   • Physical device   → http://<your-lan-ip>:5000
#   • Web preview       → http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Seeded demo customer (server: `npm run seed`) - offered as a one-tap login.
EXPO_PUBLIC_DEMO_PHONE=9876543210
EXPO_PUBLIC_DEMO_PASSWORD=aurasure123

# Currency symbol used by `money()` formatting.
EXPO_PUBLIC_CURRENCY=₹
