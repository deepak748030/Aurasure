# ─────────────────────────────────────────────────────────────────────────────
# Aurasure API connection (Expo reads EXPO_PUBLIC_* from .env at build time)
# ─────────────────────────────────────────────────────────────────────────────
#
# Set this to the base URL of the Aurasure backend (no trailing slash, no
# /api/v1). When it is EMPTY or missing, the app uses the built-in mock data
# - exactly like before. Example: http://localhost:5000 (local server)
#
EXPO_PUBLIC_API_URL=

# Demo session used to fetch the signed-in user's profile, addresses and
# orders. These match the account created by `npm run seed` in server/.
EXPO_PUBLIC_API_PHONE=9876543210
EXPO_PUBLIC_API_PASSWORD=aurasure123
