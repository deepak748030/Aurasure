{
  "name": "aurasure-server",
  "version": "1.0.0",
  "description": "Aurasure super-app backend - Node.js + Express + MongoDB (Mongoose)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "seed:fresh": "cross-env SEED_FRESH=1 node src/seed.js",
    "check": "node --check src/server.js && node scripts/check-syntax.js",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "aurasure",
    "express",
    "mongodb",
    "mongoose",
    "super-app"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.4.3"
  }
}
