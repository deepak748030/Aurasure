# Remote Aurasure API origin. Do not use localhost for a browser/Expo web build;
# use the public Node server origin or the Arena API preview origin.
# Example: https://api.aurasure.app
EXPO_PUBLIC_API_URL=

# Set to 1 to force the Play in-app update check in a debug build (device must
# have the app installed from the Play Store). Leave unset/0 in production.
EXPO_PUBLIC_IN_APP_UPDATE_DEBUG=0
